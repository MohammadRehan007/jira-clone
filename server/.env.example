PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jira_clone?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=https://your-frontend.vercel.app

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo (Recommended for Render / Cloud hosting - HTTP API Port 443)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_brevo_verified_email@gmail.com
BREVO_SENDER_NAME=Jira Engine

# Optional Gmail SMTP Configuration (Works locally, but ports 465/587 are blocked on Render free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Jira Engine" <your_email@gmail.com>

