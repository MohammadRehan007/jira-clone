{
  "name": "jira-clone-monorepo",
  "version": "1.0.0",
  "description": "Production-grade Jira Ticketing & Sprint Management System",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "server": "npm run start --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix server",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["jira", "ticketing", "sprint", "kanban", "nodemailer", "react", "express", "mongodb"],
  "author": "Antigravity",
  "license": "ISC"
}
